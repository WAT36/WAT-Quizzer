{
  "name": "wat-quizzer",
  "version": "1.0.0",
  "description": "csv_quiz_bot 2nd edition by WAT",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "main": "index.js",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build:lib": "pnpm --filter quizzer-lib build",
    "build:backend": "pnpm build:lib && pnpm --filter backend-nest build",
    "build:frontend": "pnpm --filter frontend-next build",
    "deps:check": "pnpm dlx syncpack@12 list-mismatches",
    "deps:fix": "pnpm dlx syncpack@12 fix-mismatches",
    "start:backend": "pnpm --filter backend-nest build && pnpm --filter backend-nest start:dev",
    "start:frontend": "pnpm --filter frontend-next dev",
    "start": "pnpm install && pnpm build:lib && concurrently -n backend,frontend -c blue,green \"pnpm:start:backend\" \"pnpm:start:frontend\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WAT36/WAT-Quizzer.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/WAT36/WAT-Quizzer/issues"
  },
  "homepage": "https://github.com/WAT36/WAT-Quizzer#readme",
  "devDependencies": {
    "@types/eslint-scope": "^3.7.4",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "concurrently": "^10.0.5",
    "eslint": "^9.27.0"
  }
}
